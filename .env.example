# Where creations and accounts are stored.
# Left as localhost, `npm run dev` starts a local MongoDB in Docker for you.
# Point it at a hosted database (e.g. Atlas) and it will use that instead.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="scaid"

# Signs the login cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-random-32-plus-character-string"

# Powers the design agent. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional — defaults to claude-opus-5.
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_DESIGN_EFFORT="low"
# ANTHROPIC_REPAIR_MODEL="claude-sonnet-5"

# Beta signup gate. Defaults to "scaidtester" if unset — set this in your host to rotate
# the code without a deploy. Checked server-side only, so it never reaches the browser.
# SIGNUP_CODE="scaidtester"
