{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/view.mjs\" --hook --url \"${user_config.host}\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
